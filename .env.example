# ==============================================================================
# Dockge Environment Configuration (.env.example)
# Copy this file to `.env` to configure Dockge and Proxmox Backup Server (PBS).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dockge Core Settings
# ------------------------------------------------------------------------------

# Directory where Docker Compose stacks are stored (configured via compose.yaml)
# DOCKGE_STACKS_DIR=/opt/stacks

# Directory where Dockge stores its SQLite database (`dockge.db`)
DOCKGE_DATA_DIR=./data/

# HTTP server bind address and port (default: 5001)
# DOCKGE_HOSTNAME=0.0.0.0
# DOCKGE_PORT=5001

# Allow arbitrary host shell commands inside the Dockge web UI console (default: false)
# DOCKGE_ENABLE_CONSOLE=false

# Optional HTTPS / TLS Configuration
# DOCKGE_SSL_KEY=/path/to/privkey.pem
# DOCKGE_SSL_CERT=/path/to/fullchain.pem
# DOCKGE_SSL_KEY_PASSPHRASE=

# ------------------------------------------------------------------------------
# 2. Proxmox Backup Server (PBS) Integration
# Note: These values act as defaults/fallbacks and can also be configured
# directly in the Dockge Web UI under Settings -> Backup.
# ------------------------------------------------------------------------------

# Enable Proxmox Backup Server integration ("true" or "false")
PBS_ENABLED=true

# Proxmox Backup Server hostname or IP address
PBS_HOST=192.168.1.50

# Proxmox Backup Server port (default: 8007)
PBS_PORT=8007

# Target PBS datastore name
PBS_DATASTORE=backup-ds

# PBS Auth ID (API token `user@realm!tokenid` strongly recommended, or `root@pam`)
PBS_AUTH_ID=dockge@pbs!backup-token

# PBS API Token Secret or User Password
# (Passed strictly via child process environment variables, never CLI arguments)
PBS_SECRET=your-pbs-api-token-secret-here

# SHA-256 TLS Certificate Fingerprint of the PBS server
# Required when PBS uses a self-signed TLS certificate.
# Obtain via: proxmox-backup-manager cert info | grep Fingerprint
PBS_FINGERPRINT=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99:aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99

# Optional: PBS Namespace inside the datastore (leave empty for root namespace)
# PBS_NAMESPACE=dockge-nodes

# Optional: Base Backup ID used on PBS (defaults to hostname; stacks are stored as <PBS_BACKUP_ID>-<stackName>)
PBS_BACKUP_ID=dockge

# Optional: Client-side encryption password for `.pxar` archives
# PBS_ENCRYPTION_PASSWORD=

